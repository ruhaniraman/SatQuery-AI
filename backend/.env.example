# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit real values.

# Deployed website address(es) allowed to call this backend, comma-separated (no trailing slash).
# Without it only the local dev server (http://localhost:5173) is allowed.
CORS_ORIGINS=https://your-project.vercel.app,http://localhost:5173

# Sign-in is required on /analyze, /preview and /report. Set to 0 only for local development.
REQUIRE_SIGN_IN=1

# Email sign-up sends a 6-digit code over SMTP (e.g. Gmail with an app password: smtp.gmail.com, 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# "Continue with Google": the OAuth client id from Google Cloud Console (add the website to its
# Authorised JavaScript origins).
GOOGLE_CLIENT_ID=

# Optional: delete report folders older than this many hours (unset = keep forever).
REPORT_RETENTION_HOURS=
