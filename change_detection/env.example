# Copy this file to .env and fill in real values before running main_api.py

# Member 1: enables real LLM-based intent classification in llm_classifier.py.
# If unset, routing transparently falls back to the keyword-based mock
# classifier in agent_controller.py -- the app still runs fine without this.
ANTHROPIC_API_KEY=

# Member 2: if Florence-2 / Qwen2-VL weights aren't cached locally yet,
# the HuggingFace hub will download them on first run -- ~5-10GB combined.
# Set this only if pulling from a gated/private HF repo.
HF_TOKEN=
