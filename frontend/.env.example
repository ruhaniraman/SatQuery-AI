# Copy to frontend/.env for local builds. On Vercel, set these under Project Settings -> Environment Variables.
# Vite bakes them into the built JavaScript, so they are PUBLIC: never put a secret here.

# Where the backend is (the ngrok address when the backend runs on the laptop). No trailing slash.
VITE_BACKEND_URL=https://endpoint-widen-blinked.ngrok-free.dev

# Google Maps key for the landing page globe (restrict it to the website's address in Google Cloud Console).
VITE_GOOGLE_MAPS_API_KEY=
